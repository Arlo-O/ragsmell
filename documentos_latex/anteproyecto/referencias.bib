	keywords = {Application software, Engineering management, Information management, Information technology, Ontologies, Programming, Software development management, Software engineering, Software measurement, Technology management},
	pages = {476--493},
	file = {Full Text PDF:C\:\\Users\\arlon\\Zotero\\storage\\43X5JT42\\Chidamber y Kemerer - 1994 - A metrics suite for object oriented design.pdf:application/pdf},
